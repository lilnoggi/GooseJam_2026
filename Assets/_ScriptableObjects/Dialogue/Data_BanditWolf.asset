  m_Script: {fileID: 11500000, guid: 0f7554a09a804574db0bfb6f42ac1cc4, type: 3}
  m_Name: Data_BanditWolf
  m_EditorClassIdentifier: Assembly-CSharp::EnemyDialogueData
  TurnStartDialogue:
  - Enough waiting. My Turn!
  - Time to crack some skulls!
  - Let's break things!
  ThinkingDialogue:
  - Logic is for nerds. I smash.
  - Grrr... just let me play!
  - Which of these hurts most?!
  TargetedDialogue:
  - YEAH! COME ON!
  - FINALLY!
  - Hit me!
  BluffingDialogue:
  - Try and block THIS!
  - Nothing but pure damage!
  - I'm going all in!
  CallCheatDialogue:
  - YOU'RE LYING!
  - I call bull!
  - Show 'em or I'll break 'em.
  CaughtLyingDialogue:
  - GRAAAH! Whatever!
  - Who cares about the rules?!
  - Next time, I'm just biting you.
  SuccessfullDialogue:
  - Haha! Weak!
  - Too easy to crush you!
  - Is that all you got?!
  DefeatedDialogue:
  - Keep your stupid cards. I'm done!
  - I fold! Next time I'm just eating you.
  - Whatever. Rules are for weaklings anyway.
