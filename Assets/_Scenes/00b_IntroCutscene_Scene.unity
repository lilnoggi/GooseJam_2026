  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbc7e1bb1810762499461b0414ffbf85, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntroManager
  _dialogueText: {fileID: 4872664732671986421}
  _actionButton: {fileID: 9080203283577978499}
  _buttonText: {fileID: 6465775429665612021}
  _storyLines:
  - Centries ago, the High Council banished our flock of geese to the sunless, underground
    depths beneath the kingdom.
  - Our only crime?
  - We were "too loud."
  - Now, we rot in illicit gambling dens, watching the realm leaders hoard their
    wealth while we starve underground.
  - 'But the Council has a fatal weakness: a sick obsession with a game of deception.'
  - If we want our place back in the Kingdom, we have to beat them at their own twisted
    game of Cheat.
  - 'The path to the Swan Queen''s Castle begins here, in the damp rot of the Swamp
    where Freddy the Fox is waiting. '
  - It is time to fight back.
  _typingSpeed: 0.02
  _nextSceneToLoad: 00d_Tutorial_Scene
